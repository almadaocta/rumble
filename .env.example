# Claude API (bring your own key — https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Wahoo (optional — leave blank to run in chat-only mode)
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=http://localhost:3001/api/wahoo/callback
WAHOO_WEBHOOK_TOKEN=

# Database — SQLite, a single local file. No server, no Docker.
DATABASE_PATH=./data/rumble.db

# Security
ENCRYPTION_KEY=          # openssl rand -hex 32

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Athlete (single local athlete, no auth/multi-tenancy)
ATHLETE_TIMEZONE=Europe/Madrid
